# Copy to .env and fill in. Never commit .env.
# Owner connection: runs migrations only.
DATABASE_OWNER_URL=postgres://tc_owner:change-me@localhost:5432/tc_hunter
# App connection: the role every request uses. It cannot bypass row-level security.
DATABASE_URL=postgres://tc_app:change-me@localhost:5432/tc_hunter
# 32 random bytes, base64. Wraps each applicant's own data key. Generate: openssl rand -base64 32
TC_MASTER_KEY=
# Minutes of inactivity before sign-in expires.
SESSION_IDLE_MINUTES=60
# Minutes a fresh sign-in check stays valid for "Approve submission".
STEP_UP_MINUTES=5
# Employer-site password vault: its own key (not TC_MASTER_KEY) and its own folder.
TC_VAULT_KEY=
TC_VAULT_DIR=./.vault
# Close sign-up once every household member has an account.
ALLOW_SIGNUP=true
# The address people open TC Hunter at, e.g. https://tc-hunter.home.arpa. Passkeys only work when this is set.
TC_PUBLIC_ORIGIN=
# Resume import (decision 13.6). With a key set, resumes are read by Claude after contact details are removed.
# Leave empty, or set TC_RESUME_READER=rules, to use only the built-in reader.
ANTHROPIC_API_KEY=
TC_RESUME_READER=
# Job reading (Phase 2): with a key, the requirements in each new job are read by Claude (job text only,
# nothing about you is sent). Set TC_POSTING_READER=rules to use only the built-in reader.
TC_POSTING_READER=
# Tailoring (Phase 3): with a key, Claude may reword your resume lines for each job; every line is checked
# against your profile and anything new is blocked. Set TC_TAILOR_WRITER=rules to keep to your own words.
TC_TAILOR_WRITER=

# Connected Gmail (optional, Phase 4a). Each applicant connects their own Gmail, read-only, from Settings.
# Create an OAuth client in Google Cloud (see docs/deploy.md step 12). Leave empty to keep email off.
TC_GOOGLE_CLIENT_ID=
TC_GOOGLE_CLIENT_SECRET=
