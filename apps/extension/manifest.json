{
  "manifest_version": 3,
  "name": "TC Hunter",
  "version": "0.5.0",
  "description": "Types the answers you approved in TC Hunter into an application form, and on Greenhouse, Lever, Ashby or SmartRecruiters sends it once you approve.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TC Hunter"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  }
}
