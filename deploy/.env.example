# Copy to deploy/.env on the server. Never commit deploy/.env.
# Generate each secret with:  openssl rand -base64 32

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Encrypts each applicant's personal fields (through their own data key).
# KEEP A COPY OFFLINE (password manager). Without it, a restored backup cannot be read.
TC_MASTER_KEY=
# Encrypts the employer-site password vault. Different from TC_MASTER_KEY. Keep a copy offline too.
TC_VAULT_KEY=

# Private network access (Tailscale). Create a one-off auth key in the Tailscale admin console,
# tagged e.g. tag:tc-hunter. Funnel (public sharing) stays off.
TS_AUTHKEY=

# Backups. The age PUBLIC key lives here; the private key stays off this server.
BACKUP_AGE_RECIPIENT=age1...
# An rclone remote and folder, configured in deploy/rclone.conf, e.g. b2:tc-hunter-backups
BACKUP_REMOTE=
BACKUP_CRON=15 3 * * *

# Close sign-up after Yong and Leo have both created their accounts.
ALLOW_SIGNUP=true
SESSION_IDLE_MINUTES=60
STEP_UP_MINUTES=5

# The address you open TC Hunter at over the private network, e.g. https://tc-hunter.your-tailnet.ts.net
# Passkeys only work when this is set, and only at exactly this address.
TC_PUBLIC_ORIGIN=
# Resume import (decision 13.6): with a key, resumes are read by Claude after names, email, phone and
# address are removed. Leave empty (or TC_RESUME_READER=rules) to use only the built-in reader.
ANTHROPIC_API_KEY=
TC_RESUME_READER=
# Job reading (Phase 2): with a key, the requirements in each new job are read by Claude (job text only,
# nothing about you is sent). Set TC_POSTING_READER=rules to use only the built-in reader.
TC_POSTING_READER=
