{
  "name": "tc-hunter-desktop",
  "productName": "TC Hunter",
  "version": "0.1.0",
  "private": true,
  "description": "TC Hunter for Mac: the TC Hunter app in its own window, with the Workday reader built in.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "proof": "electron . --proof",
    "dist": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.tchunter.desktop",
    "productName": "TC Hunter",
    "files": ["main.js", "preload.js", "reader.js", "workday.js", "prefs.js", "package.json"],
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    },
    "dmg": { "title": "TC Hunter" },
    "artifactName": "TC-Hunter-${version}-${arch}.${ext}"
  }
}
